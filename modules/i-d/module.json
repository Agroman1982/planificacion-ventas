{
  "id": "i-d",
  "name": "Investigacion y Desarrollo",
  "schema": {
    "fields": [
      {
        "name": "producto",
        "label": "Producto",
        "type": "text",
        "required": true,
        "placeholder": "Nombre comercial o codigo del producto potencial",
        "width": 200,
        "order": 1
      },
      {
        "name": "tipoProducto",
        "label": "Tipo de producto",
        "type": "select",
        "required": true,
        "options": ["Insecticida", "Fungicida", "Bioinsumo", "Bioestimulante", "Micronutriente", "Otro"],
        "default": "Bioinsumo",
        "width": 140,
        "order": 2
      },
      {
        "name": "representante",
        "label": "Representante (Promotor o RTC)",
        "type": "userselect",
        "required": false,
        "width": 180,
        "order": 3
      },
      {
        "name": "ubicacionEnsayo",
        "label": "Ubicacion del ensayo",
        "type": "text",
        "required": false,
        "placeholder": "Lugar / region / fundo",
        "width": 200,
        "order": 4
      },
      {
        "name": "plaga",
        "label": "Plaga",
        "type": "text",
        "required": false,
        "placeholder": "Plaga o enfermedad objetivo",
        "width": 160,
        "order": 5
      },
      {
        "name": "cultivo",
        "label": "Cultivo",
        "type": "text",
        "required": false,
        "placeholder": "Cultivo del ensayo",
        "width": 160,
        "order": 6
      },
      {
        "name": "observaciones",
        "label": "Observaciones",
        "type": "textarea",
        "required": false,
        "width": 300,
        "order": 7
      },
      {
        "name": "actividades",
        "label": "ACTIVIDADES",
        "type": "activities",
        "required": false,
        "width": 300,
        "order": 8
      },
      {
        "name": "suspendido",
        "label": "Ensayo suspendido",
        "type": "select",
        "required": false,
        "options": ["No", "Si"],
        "default": "No",
        "width": 140,
        "order": 9
      }
    ],
    "actividadesTemplate": [
      { "key": "solicitudMuestras",    "nombre": "Solicitud de muestras",        "grupo": "",               "tipoFecha": "exacta", "esEvaluacion": false, "adjunto": false },
      { "key": "recepcionMuestras",    "nombre": "Recepcion de muestras",        "grupo": "",               "tipoFecha": "exacta", "esEvaluacion": false, "adjunto": false },
      { "key": "elaboracionProtocolo", "nombre": "Elaboracion de protocolo",     "grupo": "",               "tipoFecha": "rango",  "esEvaluacion": false, "adjunto": true  },
      { "key": "ubicacionCampo",       "nombre": "Ubicacion campo experimental", "grupo": "",               "tipoFecha": "rango",  "esEvaluacion": false, "adjunto": false },
      { "key": "instalacion",          "nombre": "Instalacion",                  "grupo": "Ensayo de campo", "tipoFecha": "exacta", "esEvaluacion": false, "adjunto": false },
      { "key": "eval1",                "nombre": "Evaluacion 1",                 "grupo": "Ensayo de campo", "tipoFecha": "exacta", "esEvaluacion": true,  "adjunto": false },
      { "key": "eval2",                "nombre": "Evaluacion 2",                 "grupo": "Ensayo de campo", "tipoFecha": "exacta", "esEvaluacion": true,  "adjunto": false },
      { "key": "eval3",                "nombre": "Evaluacion 3",                 "grupo": "Ensayo de campo", "tipoFecha": "exacta", "esEvaluacion": true,  "adjunto": false },
      { "key": "eval4",                "nombre": "Evaluacion 4",                 "grupo": "Ensayo de campo", "tipoFecha": "exacta", "esEvaluacion": true,  "adjunto": false },
      { "key": "elaboracionInforme",   "nombre": "Elaboracion de informe",       "grupo": "",               "tipoFecha": "rango",  "esEvaluacion": false, "adjunto": false },
      { "key": "presentacionInforme",  "nombre": "Presentacion informe",         "grupo": "",               "tipoFecha": "exacta", "esEvaluacion": false, "adjunto": false }
    ],
    "basicDetailFields": [
      "producto", "tipoProducto", "plaga", "cultivo", "representante", "ubicacionEnsayo", "observaciones"
    ],
    "states": {
      "values": [
        "Producto potencial",
        "Muestras solicitadas",
        "Protocolo en elaboracion",
        "Protocolo aprobado",
        "Busqueda de campos",
        "Instalacion",
        "Evaluaciones en curso",
        "Gabinete",
        "Completado",
        "Suspendido"
      ],
      "field": "estadoGeneral",
      "colors": {
        "Producto potencial": "#9e9e9e",
        "Muestras solicitadas": "#fbc02d",
        "Protocolo en elaboracion": "#ef6c00",
        "Protocolo aprobado": "#1565c0",
        "Busqueda de campos": "#00acc1",
        "Instalacion": "#1976d2",
        "Evaluaciones en curso": "#66bb6a",
        "Gabinete": "#7b1fa2",
        "Completado": "#2e7d32",
        "Suspendido": "#c62828"
      },
      "icons": {
        "Producto potencial": "",
        "Muestras solicitadas": "",
        "Protocolo en elaboracion": "",
        "Protocolo aprobado": "",
        "Busqueda de campos": "",
        "Instalacion": "",
        "Evaluaciones en curso": "",
        "Gabinete": "",
        "Completado": "\u2713",
        "Suspendido": "\u2717"
      }
    },
    "views": {
      "lista": {
        "enabled": true,
        "label": "Lista",
        "icon": "\ud83d\udccb",
        "filters": ["estadoGeneral", "tipoProducto"],
        "sortBy": "createdAt",
        "columns": ["producto", "tipoProducto", "plaga", "cultivo", "representante", "ubicacionEnsayo"]
      },
      "calendario": {
        "enabled": true,
        "label": "Calendario",
        "icon": "\ud83d\udcc5",
        "colorBy": "estadoGeneral",
        "dateField": "fechaInstalacion",
        "showWeekends": true,
        "dayFields": ["producto", "estadoGeneral"]
      },
      "cronograma": {
        "enabled": true,
        "label": "Cronograma",
        "icon": "\ud83d\udcc8",
        "dateStart": "fechaInstalacion",
        "dateEnd": "fechaInformePlanificada",
        "phaseFields": [
          { "field": "fechaMuestras", "label": "Muestras", "color": "#fbc02d" },
          { "field": "fechaInstalacion", "label": "Instalacion", "color": "#1976d2" },
          { "field": "fechaInformePlanificada", "label": "Informe", "color": "#7b1fa2" }
        ]
      },
      "dashboard": {
        "enabled": true,
        "label": "Resumen",
        "icon": "\ud83d\udcca",
        "metrics": ["totalEnsayos", "porEstado", "evaluacionesPendientes", "evaluacionesRealizadas", "retrasos", "proximas"]
      }
    },
    "permissions": {
      "create": ["admin", "supervisor", "coordinador"],
      "edit": ["owner", "admin", "supervisor", "coordinador"],
      "delete": ["owner", "admin", "supervisor"],
      "viewAll": ["admin", "supervisor", "coordinador"],
      "viewTeam": [],
      "viewAssigned": ["retail", "kam", "promotor"]
    },
    "features": {
      "quickStatusChange": true,
      "resultDialog": false,
      "autoWeekLabel": false,
      "teamVisibility": false,
      "exportCSV": true,
      "ownerFilter": false,
      "assignedFields": ["representante", "campo1Rtc", "campo2Rtc"],
      "moduleType": "investigacion"
    }
  }
}
