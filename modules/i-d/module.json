{
  "id": "i-d",
  "name": "Investigacion y Desarrollo",
  "schema": {
    "fields": [
      {
        "name": "producto",
        "label": "Producto",
        "type": "text",
        "required": true,
        "placeholder": "Nombre comercial o codigo del producto potencial",
        "width": 200,
        "order": 1
      },
      {
        "name": "tipoProducto",
        "label": "Tipo de producto",
        "type": "select",
        "required": true,
        "options": ["Insecticida", "Fungicida", "Bioinsumo", "Bioestimulante", "Micronutriente", "Otro"],
        "default": "Bioinsumo",
        "width": 140,
        "order": 2
      },
      {
        "name": "descripcion",
        "label": "Descripcion (ingrediente activo, cultivo, notas)",
        "type": "textarea",
        "required": false,
        "width": 300,
        "order": 3
      },
      {
        "name": "estadoMuestras",
        "label": "Estado de muestras",
        "type": "select",
        "required": false,
        "options": ["No solicitadas", "Solicitadas", "Recibidas", "Parciales"],
        "default": "No solicitadas",
        "width": 140,
        "order": 4
      },
      {
        "name": "fechaMuestras",
        "label": "Fecha muestras solicitadas",
        "type": "date",
        "required": false,
        "width": 140,
        "order": 5
      },
      {
        "name": "estadoProtocolo",
        "label": "Protocolo",
        "type": "select",
        "required": false,
        "options": ["Pendiente", "En elaboracion", "Aprobado"],
        "default": "Pendiente",
        "width": 140,
        "order": 6
      },
      {
        "name": "protocoloLink",
        "label": "Referencia del protocolo (link/nombre archivo)",
        "type": "text",
        "required": false,
        "placeholder": "Link o referencia al Excel del protocolo",
        "width": 200,
        "order": 7
      },
      {
        "name": "tratamientos",
        "label": "Tratamientos (dosis, repeticiones, testigo)",
        "type": "textarea",
        "required": false,
        "placeholder": "Dosis, numero de tratamientos/repeticiones, testigo",
        "width": 300,
        "order": 8
      },
      {
        "name": "variablesEvaluar",
        "label": "Variables a evaluar",
        "type": "textarea",
        "required": false,
        "placeholder": "Incidencia, severidad, rendimiento, etc.",
        "width": 300,
        "order": 9
      },
      {
        "name": "fechaInstalacion",
        "label": "Fecha instalacion planificada",
        "type": "date",
        "required": false,
        "width": 140,
        "order": 10
      },
      {
        "name": "campo1Rtc",
        "label": "Campo 1 - RTC",
        "type": "userselect",
        "required": false,
        "width": 160,
        "order": 11
      },
      {
        "name": "campo1Ubicacion",
        "label": "Campo 1 - Ubicacion",
        "type": "text",
        "required": false,
        "placeholder": "Lugar / region",
        "width": 160,
        "order": 12
      },
      {
        "name": "campo1Cliente",
        "label": "Campo 1 - Cliente / Propietario",
        "type": "text",
        "required": false,
        "width": 180,
        "order": 13
      },
      {
        "name": "campo2Rtc",
        "label": "Campo 2 - RTC",
        "type": "userselect",
        "required": false,
        "width": 160,
        "order": 14
      },
      {
        "name": "campo2Ubicacion",
        "label": "Campo 2 - Ubicacion",
        "type": "text",
        "required": false,
        "placeholder": "Lugar / region",
        "width": 160,
        "order": 15
      },
      {
        "name": "campo2Cliente",
        "label": "Campo 2 - Cliente / Propietario",
        "type": "text",
        "required": false,
        "width": 180,
        "order": 16
      },
      {
        "name": "evaluaciones",
        "label": "Evaluaciones (instalacion, 1ra, 2da, 3ra...)",
        "type": "evaluations",
        "required": false,
        "width": 300,
        "order": 17
      },
      {
        "name": "estadoGeneral",
        "label": "Estado general",
        "type": "select",
        "required": true,
        "options": [
          "Producto potencial",
          "Muestras solicitadas",
          "Protocolo en elaboracion",
          "Protocolo aprobado",
          "Busqueda de campos",
          "Instalacion",
          "Evaluaciones en curso",
          "Gabinete",
          "Completado",
          "Suspendido"
        ],
        "default": "Producto potencial",
        "width": 180,
        "order": 18
      },
      {
        "name": "fechaInformePlanificada",
        "label": "Fecha informe planificada",
        "type": "date",
        "required": false,
        "width": 140,
        "order": 19
      },
      {
        "name": "observaciones",
        "label": "Observaciones",
        "type": "textarea",
        "required": false,
        "width": 300,
        "order": 20
      }
    ],
    "states": {
      "values": [
        "Producto potencial",
        "Muestras solicitadas",
        "Protocolo en elaboracion",
        "Protocolo aprobado",
        "Busqueda de campos",
        "Instalacion",
        "Evaluaciones en curso",
        "Gabinete",
        "Completado",
        "Suspendido"
      ],
      "field": "estadoGeneral",
      "colors": {
        "Producto potencial": "#9e9e9e",
        "Muestras solicitadas": "#fbc02d",
        "Protocolo en elaboracion": "#ef6c00",
        "Protocolo aprobado": "#1565c0",
        "Busqueda de campos": "#00acc1",
        "Instalacion": "#1976d2",
        "Evaluaciones en curso": "#66bb6a",
        "Gabinete": "#7b1fa2",
        "Completado": "#2e7d32",
        "Suspendido": "#c62828"
      },
      "icons": {
        "Producto potencial": "",
        "Muestras solicitadas": "",
        "Protocolo en elaboracion": "",
        "Protocolo aprobado": "",
        "Busqueda de campos": "",
        "Instalacion": "",
        "Evaluaciones en curso": "",
        "Gabinete": "",
        "Completado": "\u2713",
        "Suspendido": "\u2717"
      }
    },
    "views": {
      "lista": {
        "enabled": true,
        "label": "Lista",
        "icon": "\ud83d\udccb",
        "filters": ["estadoGeneral", "tipoProducto"],
        "sortBy": "createdAt",
        "columns": ["producto", "tipoProducto", "estadoGeneral", "campo1Rtc", "campo2Rtc", "fechaInstalacion"]
      },
      "calendario": {
        "enabled": true,
        "label": "Calendario",
        "icon": "\ud83d\udcc5",
        "colorBy": "estadoGeneral",
        "dateField": "fechaInstalacion",
        "showWeekends": true,
        "dayFields": ["producto", "estadoGeneral"]
      },
      "cronograma": {
        "enabled": true,
        "label": "Cronograma",
        "icon": "\ud83d\udcc8",
        "dateStart": "fechaInstalacion",
        "dateEnd": "fechaInformePlanificada",
        "phaseFields": [
          { "field": "fechaMuestras", "label": "Muestras", "color": "#fbc02d" },
          { "field": "fechaInstalacion", "label": "Instalacion", "color": "#1976d2" },
          { "field": "fechaInformePlanificada", "label": "Informe", "color": "#7b1fa2" }
        ]
      },
      "dashboard": {
        "enabled": true,
        "label": "Resumen",
        "icon": "\ud83d\udcca",
        "metrics": ["totalEnsayos", "porEstado", "evaluacionesPendientes", "evaluacionesRealizadas", "retrasos", "proximas"]
      }
    },
    "permissions": {
      "create": ["admin", "supervisor", "coordinador"],
      "edit": ["owner", "admin", "supervisor", "coordinador"],
      "delete": ["owner", "admin", "supervisor"],
      "viewAll": ["admin", "supervisor", "coordinador"],
      "viewTeam": [],
      "viewAssigned": ["retail", "kam", "promotor"]
    },
    "features": {
      "quickStatusChange": true,
      "resultDialog": false,
      "autoWeekLabel": false,
      "teamVisibility": false,
      "exportCSV": true,
      "ownerFilter": false,
      "assignedFields": ["campo1Rtc", "campo2Rtc"],
      "moduleType": "investigacion"
    }
  }
}
